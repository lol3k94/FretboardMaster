<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151718">

    <TextView
        android:id="@+id/tvTargetNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to tune"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#00E676"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <ImageView
        android:id="@+id/ivHeadstock"
        android:layout_width="260dp"
        android:layout_height="0dp"
        android:src="@drawable/headstock"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/tvTargetNote"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnD4"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:text="D"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@drawable/circle_bg"
        app:layout_constraintEnd_toStartOf="@id/ivHeadstock"
        app:layout_constraintTop_toTopOf="@id/ivHeadstock"
        app:layout_constraintBottom_toBottomOf="@id/ivHeadstock"
        android:layout_marginEnd="-10dp"
        app:layout_constraintVertical_bias="0.18"/>

    <Button
        android:id="@+id/btnA5"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:text="A"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@drawable/circle_bg"
        app:layout_constraintEnd_toStartOf="@id/ivHeadstock"
        app:layout_constraintTop_toTopOf="@id/ivHeadstock"
        app:layout_constraintBottom_toBottomOf="@id/ivHeadstock"
        android:layout_marginEnd="-15dp"
        app:layout_constraintVertical_bias="0.32"/>

    <Button
        android:id="@+id/btnE6"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:text="E"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@drawable/circle_bg"
        app:layout_constraintEnd_toStartOf="@id/ivHeadstock"
        app:layout_constraintTop_toTopOf="@id/ivHeadstock"
        app:layout_constraintBottom_toBottomOf="@id/ivHeadstock"
        android:layout_marginEnd="-20dp"
        app:layout_constraintVertical_bias="0.46"/>

    <Button
        android:id="@+id/btnG3"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:text="G"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@drawable/circle_bg"
        app:layout_constraintStart_toEndOf="@id/ivHeadstock"
        app:layout_constraintTop_toTopOf="@id/ivHeadstock"
        app:layout_constraintBottom_toBottomOf="@id/ivHeadstock"
        android:layout_marginStart="-10dp"
        app:layout_constraintVertical_bias="0.18"/>

    <Button
        android:id="@+id/btnB2"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:text="B"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@drawable/circle_bg"
        app:layout_constraintStart_toEndOf="@id/ivHeadstock"
        app:layout_constraintTop_toTopOf="@id/ivHeadstock"
        app:layout_constraintBottom_toBottomOf="@id/ivHeadstock"
        android:layout_marginStart="-15dp"
        app:layout_constraintVertical_bias="0.32"/>

    <Button
        android:id="@+id/btnE1"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:text="E"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@drawable/circle_bg"
        app:layout_constraintStart_toEndOf="@id/ivHeadstock"
        app:layout_constraintTop_toTopOf="@id/ivHeadstock"
        app:layout_constraintBottom_toBottomOf="@id/ivHeadstock"
        android:layout_marginStart="-20dp"
        app:layout_constraintVertical_bias="0.46"/>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Powrót"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2A2A2C"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>